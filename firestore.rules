rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.uid == 'Il06ZJBoUMetSnXX1VGjvN5KxSA3'
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.id == productId
        && request.resource.data.name is string
        && request.resource.data.description is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.updated_at is string;
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.id == categoryId
        && request.resource.data.name is string
        && request.resource.data.updated_at is string;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin()
        || (isOwner(userId) && request.resource.data.id == userId
          && request.resource.data.role == 'buyer');
      allow update: if isAdmin()
        || (isOwner(userId) && request.resource.data.id == userId
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /favorites/{favoriteId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid
        && request.resource.data.product_id is string;
      allow update: if signedIn() && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /cartItems/{itemId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid
        && request.resource.data.quantity is int && request.resource.data.quantity > 0;
      allow update: if signedIn() && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.quantity is int && request.resource.data.quantity > 0;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /addresses/{addressId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if signedIn() && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /storeAddress/{storeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && storeId == 'store';
    }

    match /_deletions/{deletionId} {
      allow read: if resource.data.owner_uid == ''
        || (signedIn() && resource.data.owner_uid == request.auth.uid);
      allow create, update: if isAdmin() && request.resource.data.owner_uid == ''
        || (signedIn() && request.resource.data.owner_uid == request.auth.uid
          && request.resource.data.collection in ['favorites', 'cartItems', 'addresses']);
      allow delete: if isAdmin() || (signedIn() && resource.data.owner_uid == request.auth.uid);
    }
  }
}
